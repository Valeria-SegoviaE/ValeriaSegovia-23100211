{
  "source": {
    "include": ["middleware/validaciones.js"],
    "exclude": ["node_modules"],
    "includePattern": ".+\\.js(doc|x)?$",
    "excludePattern": "(^|\\/|\\\\)_"
  },
  "plugins": [
    "plugins/markdown",
    "better-docs/category",
    "better-docs/typedefs"
  ],
  "opts": {
    "template": "node_modules/better-docs",
    "encoding": "utf8",
    "destination": "./out/",
    "recurse": true
  },
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": true,
    "default": {
      "outputSourceFiles": true
    }
  }
}